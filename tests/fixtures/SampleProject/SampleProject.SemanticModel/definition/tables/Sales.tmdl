table Sales
	lineageTag: a1b2c3d4-0001-4000-8000-000000000001

	measure 'Total Sales' = SUM(Sales[Amount])
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000010

	measure 'Total Sales x2' = [Total Sales] * 2
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000011

	measure 'West Region Sales' = CALCULATE([Total Sales], Customer[Region] = "West")
		formatString: #,0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000012

	column OrderDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: a1b2c3d4-0001-4000-8000-000000000020
		summarizeBy: none
		sourceColumn: OrderDate

		annotation SummarizationSetBy = Automatic

	column CustomerID
		dataType: int64
		formatString: 0
		lineageTag: a1b2c3d4-0001-4000-8000-000000000021
		summarizeBy: none
		sourceColumn: CustomerID

	column Amount
		dataType: double
		formatString: #,0.00
		lineageTag: a1b2c3d4-0001-4000-8000-000000000022
		summarizeBy: sum
		sourceColumn: Amount

	partition Sales = m
		mode: import
		source =
				let
					Source = Table.FromRows({}, {"OrderDate", "CustomerID", "Amount"})
				in
					Source

	annotation PBI_ResultType = Table

